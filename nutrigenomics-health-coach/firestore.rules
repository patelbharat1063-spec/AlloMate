rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in account can access only its own private workspace documents.
    // The app stores personal journal data in "state" and business records in "workspace".
    match /users/{userId}/private/{documentId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && documentId in ['state', 'workspace'];
    }

    // Deny all other client access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
